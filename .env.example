# === OBRIGATÓRIO para vender de verdade ===
# Crie em: https://www.mercadopago.com.br/developers/panel/app
# 1. Crie uma aplicação
# 2. Copie o Access Token de PRODUÇÃO (não o de teste)
MP_ACCESS_TOKEN=APP_USR-cole-seu-token-de-producao-aqui

# URL pública do site (sem barra no final). Exemplos:
# - https://precificaja.seu-dominio.com.br
# - https://seu-app.railway.app
# - https://seu-app.onrender.com
PUBLIC_URL=http://localhost:3000

# Porta local (opcional)
PORT=3000

# Segredo interno para assinar links de download (qualquer string longa)
DOWNLOAD_SECRET=troque-por-uma-frase-longa-aleatoria-123456

# PIX do dono (documentação / fallback manual — o dinheiro do MP cai na conta MP vinculada)
OWNER_PIX_KEY=11986637470
OWNER_PIX_KEY_TYPE=telefone
